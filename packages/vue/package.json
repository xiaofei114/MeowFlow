{
  "name": "@meowflow/vue",
  "version": "0.1.0",
  "description": "MeowFlow 前端适配：Vue3 headless composable 与默认样式组件",
  "keywords": [
    "ai",
    "agent",
    "llm",
    "vue",
    "vue3",
    "chat",
    "sse"
  ],
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@meowflow/protocol": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "vue": "^3.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaofei114/MeowFlow.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/xiaofei114/MeowFlow/tree/main/packages/vue#readme",
  "bugs": {
    "url": "https://github.com/xiaofei114/MeowFlow/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
