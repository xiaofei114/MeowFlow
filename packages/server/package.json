{
  "name": "@xiaofeiqwq/server",
  "version": "0.1.0",
  "description": "MeowFlow 服务端适配：基于协议规范的 HTTP + SSE 接口，供任意语言的前端或后端对接",
  "keywords": [
    "ai",
    "agent",
    "llm",
    "server",
    "sse",
    "http",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xiaofeiqwq/core": "workspace:*",
    "@xiaofeiqwq/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.7.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaofei114/MeowFlow.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/xiaofei114/MeowFlow/tree/main/packages/server#readme",
  "bugs": {
    "url": "https://github.com/xiaofei114/MeowFlow/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
