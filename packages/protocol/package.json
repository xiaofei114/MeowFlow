{
  "name": "@xiaofeiqwq/protocol",
  "version": "0.1.0",
  "description": "MeowFlow 事件协议：前后端与其他语言共用的类型、SSE 编解码与 JSON Schema",
  "keywords": [
    "ai",
    "agent",
    "llm",
    "protocol",
    "sse",
    "event",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaofei114/MeowFlow.git",
    "directory": "packages/protocol"
  },
  "homepage": "https://github.com/xiaofei114/MeowFlow/tree/main/packages/protocol#readme",
  "bugs": {
    "url": "https://github.com/xiaofei114/MeowFlow/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
