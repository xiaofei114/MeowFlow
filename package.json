{
  "name": "meowflow-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "MeowFlow - 轻量、自由、可自定义的 AI Agent 全栈开发框架",
  "keywords": [
    "ai",
    "agent",
    "llm",
    "framework",
    "sse",
    "typescript",
    "vue"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaofei114/MeowFlow.git"
  },
  "homepage": "https://github.com/xiaofei114/MeowFlow#readme",
  "bugs": {
    "url": "https://github.com/xiaofei114/MeowFlow/issues"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "dev": "pnpm -r --parallel --filter \"./packages/*\" run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,yaml,yml,vue}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,yaml,yml,vue}\"",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.7.5",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.10.0",
    "vitest": "^2.1.3"
  }
}
