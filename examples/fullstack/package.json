{
  "name": "@xiaofeiqwq/example-fullstack",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "MeowFlow 全栈 Demo：内置 mock provider 的 SSE 服务端 + Vue3 聊天界面",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"pnpm run dev:server\" \"pnpm run dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "start": "tsx server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@xiaofeiqwq/core": "workspace:*",
    "@xiaofeiqwq/protocol": "workspace:*",
    "@xiaofeiqwq/server": "workspace:*",
    "@xiaofeiqwq/tools": "workspace:*",
    "@xiaofeiqwq/vue": "workspace:*",
    "vue": "^3.5.12"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@vitejs/plugin-vue": "^5.1.4",
    "concurrently": "^9.0.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vue-tsc": "^2.1.10"
  }
}
